{
  "name": "minsk-lead-agent",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "leads": "tsx apps/collector/src/cli/leads.ts",
    "audit": "tsx apps/auditor/src/cli/audit.ts",
    "lighthouse": "tsx apps/auditor/src/cli/lighthouse.ts",
    "score": "tsx apps/auditor/src/cli/score.ts",
    "visual-analyze": "tsx apps/auditor/src/cli/visualAnalyze.ts",
    "export:scored": "tsx apps/collector/src/cli/exportScored.ts",
    "redesign": "tsx apps/redesign/src/cli/redesign.ts",
    "cms": "tsx apps/cms/src/server.ts",
    "dashboard": "tsx apps/dashboard/src/server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx scripts/dev.ts",
    "dev:platform": "tsx scripts/dev.ts --only=platform",
    "dev:cms": "tsx scripts/dev.ts --only=cms",
    "dev:renderer": "tsx scripts/dev.ts --only=renderer",
    "infra:up": "docker compose up -d db",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d db && npx prisma db push --accept-data-loss"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@playwright/test": "^1.46.0",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-session": "^2.0.49",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "chrome-launcher": "^1.1.2",
    "cookie-session": "^2.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "http-proxy": "^1.18.1",
    "lighthouse": "^11.7.1",
    "pino": "^9.3.2",
    "playwright": "^1.46.0",
    "zod": "^3.23.8"
  }
}
